.pio/
.vscode/
*.bin
# ...except the captured attract sequence: it is source data, not a build
# artefact. Regenerating it needs PinMAME built and the game ROM in hand, so
# it belongs in the repo next to the tool that produced it.
!data/arena_attract.bin
*.elf
*.map
# per-title sound-command maps are content, not linker output (see SOUND_MAP.md)
!sound.map
fpga_bitstream/
__pycache__/
*.pyc
# build.sh output: release artifacts + MANIFEST.txt. Regenerated from any commit,
# so it is a build product, not source. Ship the directory, don't commit it.
dist/

# Binaire hote construit a la demande (capture de l'attract sous PinMAME).
tools/capture_attract

# Genere avant chaque buildfs par tools/gzip_web.py. Le versionner reviendrait
# a versionner deux fois la meme page, avec le risque qu'elles divergent.
data/arena.html.gz
